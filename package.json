{
  "name": "mern-obsidian-todo-workspace",
  "version": "1.0.0",
  "description": "Full Stack MERN Todo Platform with Obsidian Black Theme, Docker, Jenkins and Kubernetes",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "k8s:deploy": "kubectl apply -f k8s/"
  },
  "keywords": [
    "mern",
    "react",
    "bootstrap",
    "mongodb",
    "express",
    "docker",
    "jenkins",
    "kubernetes",
    "black-theme",
    "todo"
  ],
  "author": "Antigravity",
  "license": "MIT"
}
